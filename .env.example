# WalletConnect projectId (cloud.walletconnect.com) — enables WalletConnect
# wallet + "connect from your phone" flows. Without it, WalletConnect is hidden
# and desktop extensions (MetaMask, Coinbase, Rainbow) still work.
REACT_APP_WALLETCONNECT_PROJECT_ID=5b17cff5159ff870241b86532d487f16

# Backend + node (existing)
REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_SOCKET_URL=http://localhost:5001
REACT_APP_VECHAIN_NODE=https://node-testnet.vechain.energy
REACT_APP_CONTRACT_ADDRESS=